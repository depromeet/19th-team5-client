{
  "name": "19th-team5-client",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "pnpm lint:biome && pnpm typecheck",
    "lint:biome": "biome check --error-on-warnings",
    "lint:fix": "biome check --write",
    "typecheck": "tsc -b",
    "test": "pnpm test:e2e",
    "test:e2e": "playwright test --pass-with-no-tests",
    "test:e2e:install": "playwright install chromium",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "prepare": "husky"
  },
  "dependencies": {
    "@karrotmarket/react-monochrome-icon": "^1.35.0",
    "@react-three/fiber": "^9.8.2",
    "@tanstack/react-query": "^5.108.0",
    "@vanilla-extract/css": "^1.21.3",
    "@vanilla-extract/recipes": "^0.5.7",
    "axios": "^1.21.1",
    "badwords-ko": "^1.0.4",
    "react": "~19.3.1",
    "react-dom": "~19.3.1",
    "react-hook-form": "^7.92.0",
    "react-router": "^8.5.1",
    "three": "^0.187.0",
    "wavesurfer.js": "^8.1.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@playwright/test": "^1.65.1",
    "@storybook/addon-docs": "^10.6.8",
    "@storybook/react-vite": "^10.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "~19.3.0",
    "@types/react-dom": "~19.3.0",
    "@types/three": "^0.187.0",
    "@vanilla-extract/vite-plugin": "^5.2.6",
    "@vitejs/plugin-react": "^6.3.0",
    "husky": "^9.1.7",
    "storybook": "^10.6.8",
    "typescript": "~7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-svgr": "^5.2.0"
  }
}
