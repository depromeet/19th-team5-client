echo "🌿 git push 전 브랜치 이름을 확인할게요..."

# 브랜치 컨벤션: 작업유형/#이슈번호 (예: chore/#1)
# 작업유형은 커밋 메시지 prefix와 같아요. main은 예외로 허용해요
BRANCH_PATTERN='^(chore|docs|feat|fix|refactor|style)/#[0-9]+$'

# stdin 한 줄 = push 대상 하나: <로컬 ref> <로컬 sha> <원격 ref> <원격 sha>
while read -r local_ref local_sha remote_ref remote_sha; do
  # 브랜치 삭제(git push --delete)는 검사하지 않아요
  [ "$local_ref" = "(delete)" ] && continue

  # 태그 등 브랜치가 아닌 ref는 검사하지 않아요
  case "$remote_ref" in
    refs/heads/*) ;;
    *) continue ;;
  esac

  branch="${remote_ref#refs/heads/}"
  [ "$branch" = "main" ] && continue

  if ! echo "$branch" | grep -qE "$BRANCH_PATTERN"; then
    echo "❌ '$branch'은(는) 브랜치 컨벤션에 맞지 않아요. git push를 취소할게요"
    echo "   형식: 작업유형/#이슈번호 (예: chore/#1)"
    echo "   작업유형: chore, docs, feat, fix, refactor, style"
    exit 1
  fi
done

echo "✅ 브랜치 이름 확인을 통과했어요"

echo "🔨 git push 전 빌드 체크를 실행할게요..."

if ! pnpm build; then
  echo "❌ 빌드 중 에러가 발생했어요. git push를 취소할게요"
  exit 1
fi

echo "✅ 빌드 체크를 통과했어요. git push를 진행할게요"
